RewriteEngine On
RewriteOptions InheritDownBefore
Options +FollowSymLinks

# Bloquer config.php
<Files "config.php">
    Require all denied
</Files>

# version.json servi dynamiquement par version.php (toujours à jour, jamais caché)
RewriteRule ^version\.json$ version.php [L]

# Laisser passer tous les fichiers PHP de lexika
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.php$ - [L]

# ── Fraîcheur du cache (PWA iOS/Safari) ─────────────────────────────────────
<IfModule mod_headers.c>
    # HTML dynamique : jamais de cache, pour que Safari revérifie à chaque ouverture
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
